{
  "name": "arcade",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node packages/hub/src/main.ts",
    "dev": "ARCADE_HOST_PIN=${ARCADE_HOST_PIN:-letmein} node --watch packages/hub/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"packages/*/test/*.test.ts\"",
    "test:e2e": "node --test e2e/*.test.ts",
    "games": "node scripts/games.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0"
  }
}
